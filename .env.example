# ============================================================
# parser3 — справочный список переменных окружения
# ============================================================
# ВНИМАНИЕ: этот файл — только документация.
# Реальная конфигурация задаётся в docker-compose.yml,
# в секции `environment:` сервиса backend.
# Файл .env приложением НЕ читается.
# ============================================================

# --- Routing ---
ROOT_PATH=/parser3

# --- Storage (paths inside container) ---
DATA_DIR=/app/data
RESULTS_DIR=/app/results
LOG_DIR=/app/data/logs
SQLITE_DB_PATH=/app/data/parser3.db

# --- Crawler concurrency (current production values) ---
CRAWLER_MAX_CONCURRENT=8
BROWSER_POOL_SIZE=8

# --- Browser fetching ---
FETCH_USE_BROWSER=true

# --- CORS ---
CORS_ORIGINS=*
